__pycache__/
*.pyc
.venv/
venv/
# backtest.py's point-in-time snapshot cache — derived, re-fetchable, and would
# otherwise be swept into CI's `git add data/`. Not part of the public ledger.
data/backtest/

# Local secrets for football scripts (ODDS_API_KEY). NEVER commit a key.
.env.local

# nflverse play-by-play cache: ~20MB/season, ~300MB total. Re-fetchable from
# versioned release URLs; the sha256 of each season IS committed in
# data/football/pbp_manifest.json so upstream rebuilds are still detectable.
data/football/raw/pbp/
