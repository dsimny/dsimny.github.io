__pycache__/
*.pyc
.venv/
venv/
# backtest.py's point-in-time snapshot cache — derived, re-fetchable, and would
# otherwise be swept into CI's `git add data/`. Not part of the public ledger.
data/backtest/

# Local secrets for football scripts (ODDS_API_KEY). NEVER commit a key.
.env.local

# nflverse play-by-play cache: ~20MB/season, ~300MB total. Re-fetchable from
# versioned release URLs; the sha256 of each season IS committed in
# data/football/pbp_manifest.json so upstream rebuilds are still detectable.
data/football/raw/pbp/

# Historical odds snapshots: 71MB across 357 files. Re-fetchable from The Odds
# API historical endpoint (at 30 credits each), and the derived comparison in
# data/football/market_compare.json IS committed. They must not land in a repo
# GitHub Pages serves, and morning-board.yml stages with a broad `git add data/`.
# NOTE the distinction, because the two look alike and are not:
#   hist/        IGNORED. The bulk historical pull -- 942 files bought from the
#                paid 10x endpoint. Redistributing a paid feed from a public
#                Pages repo is not ours to do. Backed up outside git.
#   ncaaf_*.json / nfl_*.json  COMMITTED (not listed here). One live capture,
#                1 credit each, and they are the EVIDENCE for every graded
#                entry. A ledger whose prices cannot be re-checked is not an
#                auditable ledger, and auditability is the product.
data/football/odds/hist/
